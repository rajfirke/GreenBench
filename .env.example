# Ollama server URL (default: local)
OLLAMA_URL=http://localhost:11434

# Grid carbon intensity for CO2 estimates (g CO2/kWh)
# India: 708, US: 390, EU: 295
GRID_CARBON_INTENSITY=708

# System power estimate (watts) for full-system energy calculations
# Apple M4 Pro: ~10W, M4 Max: ~15W
SYSTEM_POWER_W=10

# Package power measured via powermetrics (watts)
# M4 Pro measured: 0.47W during sustained inference
PACKAGE_POWER_W=0.47
